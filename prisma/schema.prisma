// FlavorForge — Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH / USERS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed — null for OAuth users

  // Profile
  bio           String?
  skillLevel    SkillLevel @default(BEGINNER)

  // Preferences
  preferences   UserPreferences?
  pantry        PantryItem[]

  // Content
  recipes       Recipe[]
  savedRecipes  SavedRecipe[]
  mealPlans     MealPlan[]
  shoppingLists ShoppingList[]
  ratings       RecipeRating[]

  // Auth
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER PREFERENCES
// ─────────────────────────────────────────────────────────────────────────────

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  // Dietary
  dietaryRestrictions DietaryRestriction[]
  allergies           String[]  // e.g. ["peanuts", "shellfish"]
  cuisinePreferences  String[]  // e.g. ["Italian", "Japanese"]
  dislikedIngredients String[]

  // Meal planning
  weeklyBudget        Float?
  dailyCalorieTarget  Int?
  servingsDefault     Int    @default(2)
  cookingTimeMax      Int?   // minutes

  // Equipment
  availableEquipment  String[] // e.g. ["oven", "air_fryer", "instant_pot"]

  // UI
  measurementUnit     MeasurementUnit @default(METRIC)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// PANTRY (ingredient tracking)
// ─────────────────────────────────────────────────────────────────────────────

model PantryItem {
  id           String    @id @default(cuid())
  userId       String
  ingredientId String

  quantity     Float?
  unit         String?
  expiresAt    DateTime?
  addedAt      DateTime  @default(now())

  // Waste tracking
  urgencyScore Int       @default(0)  // 0-100; higher = expires sooner

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([userId, ingredientId])
  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// INGREDIENTS (global catalog)
// ─────────────────────────────────────────────────────────────────────────────

model Ingredient {
  id           String  @id @default(cuid())
  name         String  @unique
  nameAliases  String[]
  category     IngredientCategory
  imageUrl     String?
  season       String[] // e.g. ["spring", "summer"]

  // Nutrition per 100g
  calories     Float?
  protein      Float?
  carbs        Float?
  fat          Float?
  fiber        Float?

  // Substitutions
  substitutes  IngredientSubstitute[] @relation("BaseIngredient")
  substitutedBy IngredientSubstitute[] @relation("SubstituteIngredient")

  pantryItems  PantryItem[]
  recipeIngredients RecipeIngredient[]

  createdAt DateTime @default(now())

  @@index([name])
  @@index([category])
}

model IngredientSubstitute {
  id              String  @id @default(cuid())
  baseId          String
  substituteId    String
  conversionRatio Float   @default(1.0)
  notes           String?
  dietaryContext  String[] // e.g. ["vegan", "gluten_free"] — when this sub applies

  base        Ingredient @relation("BaseIngredient",      fields: [baseId],        references: [id])
  substitute  Ingredient @relation("SubstituteIngredient", fields: [substituteId], references: [id])

  @@unique([baseId, substituteId])
}

// ─────────────────────────────────────────────────────────────────────────────
// RECIPES
// ─────────────────────────────────────────────────────────────────────────────

model Recipe {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  authorId    String?  // null = AI-generated (anonymous)

  // Classification
  cuisine     String?
  mealType    MealType[]
  skillLevel  SkillLevel
  dietaryTags DietaryRestriction[]

  // Timing
  prepTime    Int      // minutes
  cookTime    Int      // minutes
  totalTime   Int      // computed: prepTime + cookTime
  servings    Int      @default(4)

  // Content
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  tips        String[]
  equipment   String[]

  // Media
  imageUrl    String?
  videoUrl    String?

  // AI metadata
  isAiGenerated Boolean @default(false)
  aiModel       String?
  generationId  String? @unique  // for deduplication

  // Nutrition (per serving, AI-estimated)
  calories    Float?
  protein     Float?
  carbs       Float?
  fat         Float?
  fiber       Float?

  // Origin story (AI generated)
  originStory String? @db.Text

  // Engagement
  viewCount   Int  @default(0)
  saveCount   Int  @default(0)
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  author         User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  savedBy        SavedRecipe[]
  ratings        RecipeRating[]
  mealPlanSlots  MealPlanSlot[]
  shoppingListItems ShoppingListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([cuisine])
  @@index([isAiGenerated])
  @@index([ratingAvg])
  @@index([createdAt])
}

model RecipeIngredient {
  id           String @id @default(cuid())
  recipeId     String
  ingredientId String

  quantity     Float?
  unit         String?
  notes        String?     // e.g. "finely chopped", "room temperature"
  optional     Boolean     @default(false)
  order        Int         @default(0)

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([recipeId])
}

model RecipeStep {
  id          String  @id @default(cuid())
  recipeId    String
  stepNumber  Int
  instruction String  @db.Text
  duration    Int?    // minutes — for timer in cooking mode
  timerLabel  String? // e.g. "Let the dough rest"
  imageUrl    String?
  tips        String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, stepNumber])
  @@index([recipeId])
}

model RecipeRating {
  id       String @id @default(cuid())
  recipeId String
  userId   String
  score    Int    // 1-5
  review   String? @db.Text

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([recipeId, userId])
  @@index([recipeId])
}

model SavedRecipe {
  id         String   @id @default(cuid())
  userId     String
  recipeId   String
  savedAt    DateTime @default(now())
  collection String?  // e.g. "Weeknight dinners", "Healthy"

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MEAL PLANNER
// ─────────────────────────────────────────────────────────────────────────────

model MealPlan {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("My Meal Plan")
  weekStart DateTime // Monday of the week (UTC midnight)

  // Budget
  budgetTotal Float?
  budgetUsed  Float?

  // Nutrition goals
  calorieTarget Int?

  slots MealPlanSlot[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([weekStart])
}

model MealPlanSlot {
  id         String   @id @default(cuid())
  mealPlanId String
  recipeId   String
  dayOfWeek  Int      // 0=Mon, 6=Sun
  mealType   MealType
  servings   Int      @default(2)
  notes      String?

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id])

  @@index([mealPlanId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SHOPPING LIST
// ─────────────────────────────────────────────────────────────────────────────

model ShoppingList {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("Shopping List")
  recipeId  String?  // if generated from a single recipe

  items     ShoppingListItem[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ShoppingListItem {
  id             String @id @default(cuid())
  shoppingListId String
  recipeId       String?
  name           String
  quantity       Float?
  unit           String?
  category       String?
  checked        Boolean @default(false)
  estimatedCost  Float?

  shoppingList ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  recipe       Recipe?      @relation(fields: [recipeId],       references: [id], onDelete: SetNull)

  @@index([shoppingListId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  DESSERT
  DRINK
}

enum DietaryRestriction {
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
  HALAL
  KOSHER
  KETO
  PALEO
  LOW_FODMAP
}

enum IngredientCategory {
  PRODUCE
  MEAT
  SEAFOOD
  DAIRY
  GRAINS
  LEGUMES
  SPICES
  CONDIMENTS
  OILS
  NUTS_SEEDS
  FROZEN
  CANNED
  BAKERY
  BEVERAGES
  OTHER
}

enum MeasurementUnit {
  METRIC
  IMPERIAL
}
